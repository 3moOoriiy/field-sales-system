# ============================================================
# Field Sales System - Root environment
# Copy to .env and adjust values for your environment
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=fsuser
POSTGRES_PASSWORD=ChangeMe_StrongPassword_123
POSTGRES_DB=field_sales

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=3000
DATABASE_URL=postgresql://fsuser:ChangeMe_StrongPassword_123@postgres:5432/field_sales?schema=public

# JWT
JWT_ACCESS_SECRET=replace-with-long-random-string-min-32-chars-aaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-with-different-long-random-string-bbbbbbbbbbbbbbbbbbb
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Security
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=100

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# --- Admin dashboard ---
ADMIN_PORT=5173
VITE_API_URL=http://localhost:3000

# --- Agent PWA ---
AGENT_PORT=5174
VITE_AGENT_API_URL=http://localhost:3000
